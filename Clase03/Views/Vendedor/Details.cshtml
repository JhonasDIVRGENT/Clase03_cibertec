@model Clase03.Models.Vendedor

@{
    ViewData["Title"] = "Detalle del Vendedor";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Vendedor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.VendedorId</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@Model.EsActivo</dd>
    </dl>
</div>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
