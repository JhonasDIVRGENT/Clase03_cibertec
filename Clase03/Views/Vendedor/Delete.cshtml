@model Clase03.Models.Vendedor

@{
    ViewData["Title"] = "Eliminar Vendedor";
}

<h1>@ViewData["Title"]</h1>

<h3>¿Estás seguro que quieres eliminar este vendedor?</h3>

<div>
    <h4>Vendedor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.VendedorId</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="VendedorId" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
