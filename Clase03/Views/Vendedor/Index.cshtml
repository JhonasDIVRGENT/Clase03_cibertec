@model List<Clase03.Models.Vendedor>

@{
    ViewData["Title"] = "Lista de Vendedores";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Vendedor</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Activo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vendedor in Model)
        {
            <tr>
                <td>@vendedor.VendedorId</td>
                <td>@vendedor.Nombre</td>
                <td>@(vendedor.EsActivo ? "Sí" : "No")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@vendedor.VendedorId">Ver</a> |
                    <a asp-action="Edit" asp-route-id="@vendedor.VendedorId">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@vendedor.VendedorId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
